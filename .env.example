APP_NAME="Auto Zwaktes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin (/admin): e-mail addresses that may log in outside the local environment, comma separated
ADMIN_EMAILS=

# Affiliate links (can also be set in the admin)
AFFILIATE_VEHICLE_REPORT_URL=
AFFILIATE_INSURANCE_URL=
AFFILIATE_APK_MAIL_URL=
AFFILIATE_PARTS_URL=
RDW_APP_TOKEN=

# Contactadres op de privacypagina
CONTACT_EMAIL=

# Optioneel: Claude schrijft concept-koopadviezen uit onze eigen cijfers (komen pas live na jouw goedkeuring)
AI_ADVICE_ENABLED=false
ANTHROPIC_API_KEY=
AI_ADVICE_MODEL=claude-sonnet-5-5

# Advertenties (uit tot je een advertentie-account hebt). Het script laadt pas na toestemming in de cookiebanner.
ADS_ENABLED=false
ADS_SCRIPT_URL=
CONSENT_BANNER=false

# Limieten tegen misbruik (standaardwaarden zijn meestal goed)
LIMIT_SEARCH_PER_MINUTE=60
LIMIT_APK_MAIL_PER_HOUR=3
LIMIT_RDW_LOOKUPS_PER_MINUTE=120

# Backups versleutelen met deze zin (bewaar hem ook buiten de server; zonder de zin kun je een backup niet terugzetten)
BACKUP_PASSPHRASE=

# Content Security Policy: enforce, report-only of off
CSP_MODE=enforce
