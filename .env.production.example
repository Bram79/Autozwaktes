# Productie-instellingen voor Auto Zwaktes. Kopieer naar .env op de server en vul de lege regels in.
# Controleer daarna alles met: php artisan site:check

APP_NAME="Auto Zwaktes"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://jouwdomein.nl
APP_KEY=                     # php artisan key:generate
APP_LOCALE=nl

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database (maak een eigen gebruiker met alleen rechten op deze database)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autozwaktes
DB_USERNAME=autozwaktes
DB_PASSWORD=

# Staat de site achter een proxy of load balancer (nginx op een andere server, Cloudflare, Forge-loadbalancer)?
# Zet dan hier het IP-adres van die proxy, kommagescheiden, of * als de server alleen via de proxy bereikbaar is.
# Laat leeg als bezoekers rechtstreeks bij de server uitkomen.
TRUSTED_PROXIES=

# Sessies, cache en wachtrij
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail: nodig voor de APK-herinnering (bevestiging en herinnering). Vraag de gegevens aan bij je mailprovider.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="herinnering@jouwdomein.nl"
MAIL_FROM_NAME="${APP_NAME}"

# Wie mag in /admin (jouw e-mailadres, kommagescheiden)
ADMIN_EMAILS=

# Privacypagina: wie is verantwoordelijk (naam of bedrijfsnaam, verplicht) en hoe bereik je die (verplicht), KvK-nummer is optioneel
OPERATOR_NAME=
OPERATOR_KVK=
CONTACT_EMAIL=

# Search Console: de code uit de "HTML-tag"-methode (alleen het deel achter content=)
GOOGLE_SITE_VERIFICATION=

# Affiliate-links (kan ook in de admin onder Inkomsten)
AFFILIATE_VEHICLE_REPORT_URL=
AFFILIATE_INSURANCE_URL=
AFFILIATE_PARTS_URL=
AFFILIATE_APK_MAIL_URL=

# Advertenties: laat uit tot je een advertentie-account hebt
ADS_ENABLED=false
ADS_SCRIPT_URL=
CONSENT_BANNER=false

# Optioneel: Claude schrijft concept-koopadviezen (komen pas live na jouw goedkeuring)
AI_ADVICE_ENABLED=false
ANTHROPIC_API_KEY=
AI_ADVICE_MODEL=claude-sonnet-5-5

# Drempels (aantal auto's) voor percentages en ranglijsten; de standaardwaarden zijn meestal goed
SITE_MIN_SAMPLE=100
SITE_MIN_RANKING_SAMPLE=500

# RDW: een gratis app token verhoogt de limiet (aanvragen op opendata.rdw.nl)
RDW_APP_TOKEN=

# Limieten tegen misbruik (standaardwaarden zijn meestal goed)
LIMIT_SEARCH_PER_MINUTE=60
LIMIT_APK_MAIL_PER_HOUR=3
LIMIT_RDW_LOOKUPS_PER_MINUTE=120

# Backups versleutelen met deze zin (bewaar hem ook buiten de server; zonder de zin kun je een backup niet terugzetten)
BACKUP_PASSPHRASE=
